{
  "info": {
    "_postman_id": "hrms-api-collection",
    "name": "HRMS API",
    "description": "API collection for the local HRMS FastAPI application. Use the HRMS Local environment. Start with Authentication → Login. State-changing payroll, document, leave, and email operations should only be run against local/test data. See docs/postman-guide.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (saves access token)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/login",
            "description": "Use a local test account. OAuth2PasswordRequestForm expects x-www-form-urlencoded username=email and password. This request saves access_token to the active environment.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{email}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login succeeded\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "if (pm.response.code === 200) {",
                  "  const payload = pm.response.json();",
                  "  if (payload.access_token) pm.environment.set(\"accessToken\", payload.access_token);",
                  "  if (payload.user && payload.user.id) pm.environment.set(\"userId\", String(payload.user.id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me",
            "description": "Requires a valid Bearer access token."
          },
          "response": []
        }
      ]
    },
